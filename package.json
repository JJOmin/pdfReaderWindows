{
  "name": "pdfreader",
  "version": "0.1.0-alpha.1",
  "description": "Local PDF reader with annotations and read-aloud that highlights the spoken sentence and word",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/JJOmin/pdfReaderWindows",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --config electron-builder.config.mjs --win --dir",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.mjs --win nsis",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.mjs --mac dmg --arm64",
    "models": "node scripts/fetch-models.mjs",
    "gpu-voice": "node scripts/setup-gpu-voice.mjs",
    "fixtures": "electron scripts/make-fixtures.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dump": "node scripts/dump-text.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
